{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "metrodreamin-to-kml",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-06",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},
	"workers_dev": true,
	"preview_urls": false
}
